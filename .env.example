# ECHO OS — Phase 5 third-party API credentials (TEMPLATE).
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and MUST
# NEVER be committed. These variables are read by apps/appkit/config/credentials.
# Real process environment variables override anything set here.
#
# See the README "Phase 5" section for step-by-step instructions on obtaining each
# credential, and note which account each developer app is registered under.
#
# Nothing here is needed for the default --mock build: apps only read these in
# --real mode, and any that are missing make that app degrade gracefully.

# --- Spotify (OAuth Authorization Code flow) --------------------------------
# Register an app at https://developer.spotify.com/dashboard
# Registered under: <FILL IN: which Spotify account owns this app>
ECHO_SPOTIFY_CLIENT_ID=
ECHO_SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI added in the Spotify app settings.
ECHO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Gmail (OAuth; scopes: gmail.readonly + gmail.send ONLY) -----------------
# Google Cloud Console -> enable Gmail API -> OAuth consent + OAuth client (Desktop).
# Registered under: <FILL IN: which Google account / Cloud project owns this>
ECHO_GMAIL_CLIENT_ID=
ECHO_GMAIL_CLIENT_SECRET=

# --- Google Custom Search JSON API ------------------------------------------
# Enable "Custom Search API"; create a Programmable Search Engine to get the cx id.
# Registered under: <FILL IN: which Google account / Cloud project owns this>
ECHO_GOOGLE_SEARCH_KEY=
ECHO_GOOGLE_SEARCH_CX=

# --- YouTube Data API v3 -----------------------------------------------------
# Same Cloud project as Custom Search. If unset, the search key above is reused.
# Registered under: <FILL IN: which Google account / Cloud project owns this>
ECHO_YOUTUBE_API_KEY=

# --- Local token cache directory (gitignored) --------------------------------
# Where access/refresh tokens are stored after the one-time browser consent.
# Defaults to ".echo-tokens" if unset. Never commit this directory.
ECHO_TOKEN_DIR=.echo-tokens
